# MongoDB — MUST be a replica set. transitionOrder() runs every status change
# in a transaction, and transactions throw at runtime on a standalone mongod.
# Local dev: `docker compose up -d` provides this at the URI below.
MONGODB_URI="mongodb://localhost:27017/railserve?replicaSet=rs0"

# Integration tests point here instead. resetDb() truncates every collection it
# touches, so this must be a different DATABASE from MONGODB_URI — same cluster
# is fine, same db name is not. Defaults to a local railserve_test when unset.
MONGODB_URI_TEST=""

# Auth.js session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me"

# Password assigned to every seeded user. Dev convenience only.
SEED_PASSWORD="password"

# --- Live train status (plan §8) -------------------------------------------
# With no key set, the simulator provider is used: deterministic, offline, and
# good enough to exercise delays, platform changes and the leave-now maths.
# Set both to switch to real data — this is the only change required.
TRAIN_API_PROVIDER="simulator"   # simulator | rapidapi | railkit | railkit-v2
TRAIN_API_KEY=""
# Only read when TRAIN_API_PROVIDER=rapidapi, and it must match the adapter in
# src/lib/train/rapidapi.ts — that parser maps one vendor's exact field names.
TRAIN_API_HOST="indian-railway-irctc.p.rapidapi.com"
# railkit needs no host: the `railkit` npm package holds the base URL. It is a
# dependency rather than a fetch because RailKit answers direct REST calls with
# 403 "Missing SDK signature headers", on the paid plans too.
# `railkit` reads v1 (NTES) only. `railkit-v2` reads v2 (WIMT) first and falls
# back to v1 for a failed call, a stop with no time, or a missing platform.

# Delivery proof photos — Cloudflare R2 (S3-compatible).
# Leave blank and photo capture is unavailable; delivery still works, because
# proof is optional. Create a bucket and an R2 API token to fill these in.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Shared secret for POST /api/cron/train-poll, which refreshes live train
# status and fires the leave-now alert. Point any scheduler at it:
#   curl -X POST -H "x-cron-token: $CRON_TOKEN" https://host/api/cron/train-poll
# Leave blank and the endpoint is unauthenticated — only do that locally.
# Browser origins allowed to call /api/mobile/*. Only needed to run the rider
# app on Expo web against a deployed server — a native build never sends an
# Origin and needs nothing here. Comma-separated, e.g. http://localhost:8081
MOBILE_CORS_ORIGINS=

CRON_TOKEN=""

# Minutes of buffer added when computing dispatchAt (plan §9).
DISPATCH_BUFFER_MINUTES="5"
# Delay beyond which Generate KOT asks for confirmation (plan §9).
KOT_DELAY_THRESHOLD_MINUTES="45"

# Shared secret this server uses to render a KOT ticket to an image for
# itself (see src/lib/printer/screenshot.ts) — required for printing to work
# at all, since /internal/print/* refuses every request without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
PRINT_RENDER_TOKEN=""

# FoodOnTrains: reports ACCEPTED / On platform / DELIVERED / CANCELLED back for
# FT- orders. The API key is per outlet and is stored on the outlet
# (Restaurant.foodOnTrainsApiKey), not here.
FOODONTRAINS_API_URL="https://foodontrains.in/api"

# --- WhatsApp chat (telecaller <-> passenger) --------------------------------
# simulator: no account needed; a fake passenger answers every message a
# moment later, so /calls/chat works offline. msg91: real sends through the
# MSG91 WhatsApp Business API. Blank MSG91_AUTH_KEY also means simulator.
WHATSAPP_PROVIDER="simulator"   # simulator | msg91
MSG91_AUTH_KEY=""
# The integrated WhatsApp Business number, digits with country code (91…).
MSG91_WHATSAPP_NUMBER=""
MSG91_API_URL="https://control.msg91.com/api/v5/whatsapp"
# Template namespace of the WhatsApp Business Account (MSG91 dashboard »
# WhatsApp » the number's details). Optional; sent with every template.
MSG91_TEMPLATE_NAMESPACE=""
# MSG91 Dashboard » WhatsApp » Webhook (New): callback URL
#   https://<host>/api/whatsapp/webhook?token=$MSG91_WEBHOOK_TOKEN
# for both inbound messages and outbound reports. MSG91 signs nothing, so
# this shared secret is the only thing keeping strangers out of the inbox.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MSG91_WEBHOOK_TOKEN=""
# An approved utility template that opens (or reopens) a conversation when
# the passenger has not written in 24 hours. Body variable {{1}} = order id.
MSG91_OPENER_TEMPLATE=""
MSG91_OPENER_TEMPLATE_LANG="en"
# What fills the template's body variables, in order, from: name, order, outlet.
# e.g. "name,order" for "Hi {{1}}, … your order {{2}} …".
MSG91_OPENER_TEMPLATE_VARS="order"

# --- Gmail ingestion (plan §6) ---------------------------------------------
# Unset: ingestion is manual only (paste an email at /admin/inbox). Set all of
# these to enable the Gmail watch -> Pub/Sub -> webhook path.
#   1. GCP project, Gmail API enabled, Pub/Sub topic + push subscription
#   2. OAuth client; obtain a refresh token for the shared orders mailbox
#   3. Point the Pub/Sub push endpoint at POST /api/gmail/webhook
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_TOPIC_NAME=""
GMAIL_USER_ID="me"
# Shared secret echoed by the Pub/Sub push subscription so the webhook can
# reject anything that is not ours.
GMAIL_WEBHOOK_TOKEN=""
# Alert if no order has arrived in this many hours during business hours
# (plan §6: a missed watch renewal makes ingestion fail silently).
INGEST_STALE_ALERT_HOURS="6"
