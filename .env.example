# MongoDB — MUST be a replica set. transitionOrder() runs every status change
# in a transaction, and transactions throw at runtime on a standalone mongod.
# Local dev: `docker compose up -d` provides this at the URI below.
MONGODB_URI="mongodb://localhost:27017/railserve?replicaSet=rs0"

# Auth.js session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me"

# Password assigned to every seeded user. Dev convenience only.
SEED_PASSWORD="password"
