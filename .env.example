# MongoDB — MUST be a replica set. transitionOrder() runs every status change
# in a transaction, and transactions throw at runtime on a standalone mongod.
# Local dev: `docker compose up -d` provides this at the URI below.
MONGODB_URI="mongodb://localhost:27017/railserve?replicaSet=rs0"

# Auth.js session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me"

# Password assigned to every seeded user. Dev convenience only.
SEED_PASSWORD="password"

# Redis — backs BullMQ. Host port 6380 to avoid clashing with a Redis another
# project may already have on 6379.
REDIS_URL="redis://localhost:6380"

# --- Live train status (plan §8) -------------------------------------------
# With no key set, the simulator provider is used: deterministic, offline, and
# good enough to exercise delays, platform changes and the leave-now maths.
# Set both to switch to real data — this is the only change required.
TRAIN_API_PROVIDER="simulator"   # simulator | rapidapi
TRAIN_API_KEY=""
TRAIN_API_HOST="indian-railway-irctc.p.rapidapi.com"  # must match the adapter in src/lib/train/rapidapi.ts

# Delivery proof photos — Cloudflare R2 (S3-compatible).
# Leave blank and photo capture is unavailable; delivery still works, because
# proof is optional. Create a bucket and an R2 API token to fill these in.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Minutes of buffer added when computing dispatchAt (plan §9).
DISPATCH_BUFFER_MINUTES="5"
# Delay beyond which Generate KOT asks for confirmation (plan §9).
KOT_DELAY_THRESHOLD_MINUTES="45"

# --- Gmail ingestion (plan §6) ---------------------------------------------
# Unset: ingestion is manual only (paste an email at /admin/inbox). Set all of
# these to enable the Gmail watch -> Pub/Sub -> webhook path.
#   1. GCP project, Gmail API enabled, Pub/Sub topic + push subscription
#   2. OAuth client; obtain a refresh token for the shared orders mailbox
#   3. Point the Pub/Sub push endpoint at POST /api/gmail/webhook
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_TOPIC_NAME=""
GMAIL_USER_ID="me"
# Shared secret echoed by the Pub/Sub push subscription so the webhook can
# reject anything that is not ours.
GMAIL_WEBHOOK_TOKEN=""
# Alert if no order has arrived in this many hours during business hours
# (plan §6: a missed watch renewal makes ingestion fail silently).
INGEST_STALE_ALERT_HOURS="6"
