# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never get committed.
# .env.example IS committed as the documented template.
.env*
!.env.example

# The print agent, zipped to hand to a station. The archive carries the
# agent's own .env, and AGENT_TOKEN with it — the .env* rule above cannot see
# inside a zip, and this repo is public. Build it when you need it; never
# commit it.
/agent.zip
/agent*.zip

# Finder duplicates of the agent directory ("agent 2", "agent copy"). Only
# their .env is caught by the rule above; the rest would land in the repo as a
# second, silently diverging copy of the print agent.
/agent [0-9]*/
/agent copy*/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch
/tmp/
*.log

# Vendored agent skills. Installed per-machine via `npx skills add` / the
# impeccable CLI; ~300 files we do not maintain and that carry no project code.
/.claude/
/.agents/
/.codex/
/.impeccable/

# Local DB snapshots taken by reset:admin — never commit real order data.
/.backups/

# Session/machine-specific runbooks — not project documentation.
*.local.md
captures/

# Local-only test data script (creates dummy Gaya orders in the dev DB)
/scripts/seed-gaya-test-orders.ts
