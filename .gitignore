# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never get committed.
# .env.example IS committed as the documented template.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch
/tmp/
*.log

# Vendored agent skills. Installed per-machine via `npx skills add` / the
# impeccable CLI; ~300 files we do not maintain and that carry no project code.
/.claude/
/.agents/
/.codex/
/.impeccable/

# Local DB snapshots taken by reset:admin — never commit real order data.
/.backups/

# Session/machine-specific runbooks — not project documentation.
*.local.md
