{
  "expo": {
    "name": "RailServe",
    "slug": "railserve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.railserve.rider",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.railserve.rider"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "railserve",
    "plugins": [
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RailServe shares your location with the office while you are on shift, so they can see which riders are near a platform when a train is due.",
          "locationAlwaysAndWhenInUsePermission": "RailServe keeps sharing your location while the app is in the background, so the office can still see where you are when your screen is off during a delivery.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-task-manager"
    ],
    "extra": {
      "eas": {
        "projectId": "bedfb0d5-7b69-48e8-b304-f0dd2100a23f"
      }
    }
  }
}
